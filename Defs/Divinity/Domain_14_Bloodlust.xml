    <minTier>2</minTier>
    <faithCost>30</faithCost>
    <cooldownDays>0.5</cooldownDays>
    <targetMode>Pawn</targetMode>
    <demigodOnly>true</demigodOnly>
    <amount>18</amount>
    <affects>Enemies</affects>
    <damageDef>Cut</damageDef>
  </ImAGod.DivinePowerDef>

