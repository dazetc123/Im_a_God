  <ImAGod.DivinePowerDef>
    <defName>IAG_DGP_CrimsonTide_Bloodlust</defName>
    <label>crimson tide</label>
    <description>Colonists nearby are seized by bloodlust.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHediff</workerClass>
    <iconPath>ImAGod/Domains/Bloodlust/wave</iconPath>
    <order>2</order>
    <minTier>3</minTier>
    <faithCost>90</faithCost>
    <cooldownDays>3</cooldownDays>
    <targetMode>Cell</targetMode>
    <demigodOnly>true</demigodOnly>
    <radius>4.9</radius>
    <hediffDef>IAG_CrimsonTide</hediffDef>
