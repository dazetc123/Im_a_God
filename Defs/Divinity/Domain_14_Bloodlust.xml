    <comps>
      <li Class="ImAGod.CompProperties_DivinePower">
        <power>IAG_DGP_Bloodletting_Bloodlust</power>
      </li>
    </comps>
  </AbilityDef>

  <ImAGod.DivineNodeDef>
    <defName>IAG_DGNode_Bloodlust_Bloodletting</defName>
    <label>bloodletting</label>
    <domain>IAG_Domain_Bloodlust</domain>
    <power>IAG_DGP_Bloodletting_Bloodlust</power>
    <forDemigod>true</forDemigod>
    <ability>IAG_DG_Bloodletting_Bloodlust</ability>
    <row>1</row>
    <column>0</column>
    <pointCost>2</pointCost>
    <minDemigodLevel>4</minDemigodLevel>
    <prerequisites>
      <li>IAG_DGNode_Bloodlust_Frenzy</li>
