  <ImAGod.DivineNodeDef>
    <defName>IAG_DGNode_Bloodlust_CrimsonTide</defName>
    <label>crimson tide</label>
    <domain>IAG_Domain_Bloodlust</domain>
    <power>IAG_DGP_CrimsonTide_Bloodlust</power>
    <forDemigod>true</forDemigod>
    <ability>IAG_DG_CrimsonTide_Bloodlust</ability>
    <row>2</row>
    <column>0</column>
    <pointCost>3</pointCost>
    <minDemigodLevel>7</minDemigodLevel>
    <prerequisites>
      <li>IAG_DGNode_Bloodlust_Bloodletting</li>
    </prerequisites>
  </ImAGod.DivineNodeDef>


</Defs>
