    <workerClass>ImAGod.DivinePowerWorker_Allure</workerClass>
    <iconPath>ImAGod/Domains/Desire/rose</iconPath>
    <order>0</order>
    <minTier>1</minTier>
    <faithCost>30</faithCost>
    <cooldownDays>1</cooldownDays>
    <targetMode>Pawn</targetMode>
