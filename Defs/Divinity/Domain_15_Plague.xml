  <AbilityDef ParentName="IAG_DemigodAbilityBase">
    <defName>IAG_DG_Pestilence_Plague</defName>
    <label>pestilence</label>
    <description>Strikes enemies nearby with the plague. Demigods draw on their god's faith to use this ability.</description>
