  <ImAGod.DivineNodeDef>
    <defName>IAG_DGNode_Plague_Miasma</defName>
    <label>miasma</label>
    <domain>IAG_Domain_Plague</domain>
    <power>IAG_DGP_Miasma_Plague</power>
    <forDemigod>true</forDemigod>
    <ability>IAG_DG_Miasma_Plague</ability>
    <row>1</row>
    <column>0</column>
    <pointCost>2</pointCost>
    <minDemigodLevel>4</minDemigodLevel>
    <prerequisites>
      <li>IAG_DGNode_Plague_Fever</li>
    </prerequisites>
  </ImAGod.DivineNodeDef>

  <ImAGod.DivinePowerDef>
    <defName>IAG_DGP_Pestilence_Plague</defName>
    <label>pestilence</label>
    <description>Strikes enemies nearby with the plague.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHediff</workerClass>
    <iconPath>ImAGod/Domains/Plague/biohazard</iconPath>
