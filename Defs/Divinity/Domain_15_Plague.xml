<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ImAGod.DivineDomainDef>
    <defName>IAG_Domain_Plague</defName>
    <label>plague</label>
    <description>The god of pestilence and decay. Its faithful offer it sickness and the dead, and it spares them while it rots its enemies.</description>
    <path>IAG_Path_Chaos</path>
    <iconPath>ImAGod/Domains/Plague/Domain</iconPath>
    <color>(0.55, 0.68, 0.25)</color>
    <order>5</order>
    <blessing>IAG_Blessing_Plague</blessing>
    <recordOfferings>
      <li>
        <record>TimesTendedTo</record>
        <faith>0.6</faith>
      </li>
      <li>
        <record>CorpsesBuried</record>
        <faith>1.5</faith>
      </li>
      <li>
        <record>BodiesStripped</record>
        <faith>0.5</faith>
      </li>
    </recordOfferings>
  </ImAGod.DivineDomainDef>

  <HediffDef>
    <defName>IAG_Blessing_Plague</defName>
    <label>blessing of pestilence</label>
    <description>The plague god spares its own. Its strength grows with the god's tier.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <defaultLabelColor>(0.55, 0.68, 0.25)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>4</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>I</label>
        <foodPoisoningChanceFactor>0.9</foodPoisoningChanceFactor>
        <statOffsets>
          <ToxicResistance>0.05</ToxicResistance>
        </statOffsets>
        <statFactors>
          <ImmunityGainSpeed>1.08</ImmunityGainSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>II</label>
        <foodPoisoningChanceFactor>0.8</foodPoisoningChanceFactor>
        <statOffsets>
          <ToxicResistance>0.1</ToxicResistance>
        </statOffsets>
        <statFactors>
          <ImmunityGainSpeed>1.16</ImmunityGainSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>III</label>
        <foodPoisoningChanceFactor>0.7</foodPoisoningChanceFactor>
        <statOffsets>
          <ToxicResistance>0.15</ToxicResistance>
        </statOffsets>
        <statFactors>
          <ImmunityGainSpeed>1.24</ImmunityGainSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>IV</label>
        <foodPoisoningChanceFactor>0.6</foodPoisoningChanceFactor>
        <statOffsets>
          <ToxicResistance>0.2</ToxicResistance>
        </statOffsets>
        <statFactors>
          <ImmunityGainSpeed>1.32</ImmunityGainSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- ================= miracles of the god ================= -->

  <ImAGod.DivinePowerDef>
    <defName>IAG_Fever</defName>
    <label>fever</label>
    <description>Strikes one enemy with the flu.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHediff</workerClass>
    <iconPath>ImAGod/Domains/Plague/droplet</iconPath>
    <order>0</order>
    <minTier>1</minTier>
    <faithCost>50</faithCost>
    <cooldownDays>1</cooldownDays>
    <targetMode>Pawn</targetMode>
    <amount>0.4</amount>
    <hediffDef>Flu</hediffDef>
    <affects>Enemies</affects>
  </ImAGod.DivinePowerDef>

  <ImAGod.DivineNodeDef>
    <defName>IAG_Node_Plague_Fever</defName>
    <label>fever</label>
    <domain>IAG_Domain_Plague</domain>
    <power>IAG_Fever</power>
    <row>0</row>
    <column>0</column>
    <pointCost>1</pointCost>
  </ImAGod.DivineNodeDef>

  <ImAGod.DivinePowerDef>
    <defName>IAG_IronImmunity</defName>
    <label>iron immunity</label>
    <description>Colonists in the area become resistant to disease and toxins for two days.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHediff</workerClass>
    <iconPath>ImAGod/Domains/Plague/shieldvirus</iconPath>
    <order>1</order>
    <minTier>1</minTier>
    <faithCost>50</faithCost>
    <cooldownDays>3</cooldownDays>
    <targetMode>Cell</targetMode>
    <radius>7.9</radius>
    <hediffDef>IAG_IronImmunity</hediffDef>
    <affects>Colonists</affects>
  </ImAGod.DivinePowerDef>

  <ImAGod.DivineNodeDef>
    <defName>IAG_Node_Plague_IronImmunity</defName>
    <label>iron immunity</label>
    <domain>IAG_Domain_Plague</domain>
    <power>IAG_IronImmunity</power>
    <row>0</row>
    <column>1</column>
    <pointCost>1</pointCost>
  </ImAGod.DivineNodeDef>

  <ImAGod.DivinePowerDef>
    <defName>IAG_Pestilence</defName>
    <label>pestilence</label>
    <description>Strikes every enemy in the area with the plague.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHediff</workerClass>
    <iconPath>ImAGod/Domains/Plague/biohazard</iconPath>
    <order>10</order>
    <minTier>2</minTier>
    <faithCost>160</faithCost>
    <cooldownDays>4</cooldownDays>
    <targetMode>Cell</targetMode>
    <radius>5.9</radius>
    <amount>0.35</amount>
    <hediffDef>Plague</hediffDef>
    <affects>Enemies</affects>
  </ImAGod.DivinePowerDef>

  <ImAGod.DivineNodeDef>
    <defName>IAG_Node_Plague_Pestilence</defName>
    <label>pestilence</label>
    <domain>IAG_Domain_Plague</domain>
    <power>IAG_Pestilence</power>
    <row>1</row>
    <column>0</column>
    <pointCost>2</pointCost>
    <prerequisites>
      <li>IAG_Node_Plague_Fever</li>
      <li>IAG_Node_Plague_IronImmunity</li>
    </prerequisites>
  </ImAGod.DivineNodeDef>

  <ImAGod.DivinePowerDef>
    <defName>IAG_Miasma</defName>
    <label>miasma</label>
    <description>A toxic miasma poisons every enemy in the area.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHediff</workerClass>
    <iconPath>ImAGod/Domains/Plague/cloud</iconPath>
    <order>11</order>
    <minTier>2</minTier>
    <faithCost>140</faithCost>
    <cooldownDays>3</cooldownDays>
    <targetMode>Cell</targetMode>
    <radius>5.9</radius>
    <amount>0.35</amount>
    <amountPerTier>0.1</amountPerTier>
    <hediffDef>ToxicBuildup</hediffDef>
    <affects>Enemies</affects>
  </ImAGod.DivinePowerDef>

  <ImAGod.DivineNodeDef>
    <defName>IAG_Node_Plague_Miasma</defName>
    <label>miasma</label>
    <domain>IAG_Domain_Plague</domain>
    <power>IAG_Miasma</power>
    <row>1</row>
    <column>1</column>
    <pointCost>2</pointCost>
    <prerequisites>
      <li>IAG_Node_Plague_Fever</li>
      <li>IAG_Node_Plague_IronImmunity</li>
    </prerequisites>
  </ImAGod.DivineNodeDef>

  <ImAGod.DivinePowerDef>
    <defName>IAG_BlackDeath</defName>
    <label>black death</label>
    <description>Every enemy on the map is struck with the plague.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHediff</workerClass>
    <iconPath>ImAGod/Domains/Plague/skull</iconPath>
    <order>20</order>
    <minTier>3</minTier>
    <faithCost>350</faithCost>
    <cooldownDays>10</cooldownDays>
    <targetMode>None</targetMode>
    <requiresProphet>true</requiresProphet>
    <prophetStrain>0.5</prophetStrain>
    <amount>0.5</amount>
    <hediffDef>Plague</hediffDef>
    <affects>Enemies</affects>
    <wholeMap>true</wholeMap>
    <witnessRadius>0</witnessRadius>
  </ImAGod.DivinePowerDef>

  <ImAGod.DivineNodeDef>
    <defName>IAG_Node_Plague_BlackDeath</defName>
    <label>black death</label>
    <domain>IAG_Domain_Plague</domain>
    <power>IAG_BlackDeath</power>
    <row>2</row>
    <column>0</column>
    <pointCost>3</pointCost>
    <prerequisites>
      <li>IAG_Node_Plague_Pestilence</li>
      <li>IAG_Node_Plague_Miasma</li>
    </prerequisites>
  </ImAGod.DivineNodeDef>

  <!-- ================= abilities of demigods ================= -->

  <ImAGod.DivinePowerDef>
    <defName>IAG_DGP_Fever_Plague</defName>
    <label>fever</label>
    <description>Strikes one enemy with the flu.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHediff</workerClass>
    <iconPath>ImAGod/Domains/Plague/droplet</iconPath>
    <order>0</order>
    <minTier>1</minTier>
    <faithCost>40</faithCost>
    <cooldownDays>1</cooldownDays>
    <targetMode>Pawn</targetMode>
    <demigodOnly>true</demigodOnly>
    <amount>0.35</amount>
    <hediffDef>Flu</hediffDef>
    <affects>Enemies</affects>
  </ImAGod.DivinePowerDef>

  <AbilityDef ParentName="IAG_DemigodAbilityBase">
    <defName>IAG_DG_Fever_Plague</defName>
    <label>fever</label>
    <description>Strikes one enemy with the flu. Demigods draw on their god's faith to use this ability.</description>
    <iconPath>ImAGod/Domains/Plague/droplet</iconPath>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <hostile>true</hostile>
    <verbProperties>
      <range>24.9</range>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
        <mapObjectTargetsMustBeAutoAttackable>false</mapObjectTargetsMustBeAutoAttackable>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ImAGod.CompProperties_DivinePower">
        <power>IAG_DGP_Fever_Plague</power>
      </li>
    </comps>
  </AbilityDef>

  <ImAGod.DivineNodeDef>
    <defName>IAG_DGNode_Plague_Fever</defName>
    <label>fever</label>
    <domain>IAG_Domain_Plague</domain>
    <power>IAG_DGP_Fever_Plague</power>
    <forDemigod>true</forDemigod>
    <ability>IAG_DG_Fever_Plague</ability>
    <row>0</row>
    <column>0</column>
    <pointCost>1</pointCost>
    <minDemigodLevel>1</minDemigodLevel>
  </ImAGod.DivineNodeDef>

  <ImAGod.DivinePowerDef>
    <defName>IAG_DGP_Miasma_Plague</defName>
    <label>miasma</label>
    <description>Poisons enemies nearby.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHediff</workerClass>
    <iconPath>ImAGod/Domains/Plague/cloud</iconPath>
    <order>1</order>
    <minTier>2</minTier>
    <faithCost>60</faithCost>
    <cooldownDays>2</cooldownDays>
    <targetMode>Cell</targetMode>
    <demigodOnly>true</demigodOnly>
    <radius>3.9</radius>
    <amount>0.3</amount>
    <hediffDef>ToxicBuildup</hediffDef>
    <affects>Enemies</affects>
  </ImAGod.DivinePowerDef>

