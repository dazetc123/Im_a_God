    <comps>
      <li Class="ImAGod.CompProperties_DivinePower">
        <power>IAG_DGP_Pestilence_Plague</power>
      </li>
    </comps>
  </AbilityDef>

  <ImAGod.DivineNodeDef>
    <defName>IAG_DGNode_Plague_Pestilence</defName>
    <label>pestilence</label>
    <domain>IAG_Domain_Plague</domain>
    <power>IAG_DGP_Pestilence_Plague</power>
    <forDemigod>true</forDemigod>
    <ability>IAG_DG_Pestilence_Plague</ability>
    <row>2</row>
    <column>0</column>
