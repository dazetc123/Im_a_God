  <ImAGod.DivineNodeDef>
    <defName>IAG_DGNode_Crafting_Inspire</defName>
    <label>inspire</label>
    <domain>IAG_Domain_Crafting</domain>
    <power>IAG_DGP_Inspire_Crafting</power>
