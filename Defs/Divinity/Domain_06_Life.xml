  <ImAGod.DivinePowerDef>
    <defName>IAG_DGP_HealingLight_Life</defName>
    <label>healing light</label>
    <description>Heals the colony's people nearby.</description>
    <workerClass>ImAGod.DivinePowerWorker_AreaHeal</workerClass>
    <iconPath>ImAGod/Domains/Life/sunheart</iconPath>
    <order>2</order>
    <minTier>3</minTier>
    <faithCost>80</faithCost>
    <cooldownDays>3</cooldownDays>
    <targetMode>Cell</targetMode>
    <demigodOnly>true</demigodOnly>
    <radius>4.9</radius>
    <amount>12</amount>
    <affects>Allies</affects>
  </ImAGod.DivinePowerDef>

  <AbilityDef ParentName="IAG_DemigodAbilityBase">
    <defName>IAG_DG_HealingLight_Life</defName>
    <label>healing light</label>
    <description>Heals the colony's people nearby. Demigods draw on their god's faith to use this ability.</description>
    <iconPath>ImAGod/Domains/Life/sunheart</iconPath>
    <cooldownTicksRange>180000</cooldownTicksRange>
    <hostile>false</hostile>
    <verbProperties>
      <range>24.9</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
