  <ImAGod.DivineNodeDef>
    <defName>IAG_DGNode_Life_Cure</defName>
    <label>cure</label>
    <domain>IAG_Domain_Life</domain>
    <power>IAG_DGP_Cure_Life</power>
    <forDemigod>true</forDemigod>
    <ability>IAG_DG_Cure_Life</ability>
