  <ImAGod.DivineNodeDef>
    <defName>IAG_DGNode_Life_HealingLight</defName>
    <label>healing light</label>
    <domain>IAG_Domain_Life</domain>
    <power>IAG_DGP_HealingLight_Life</power>
    <forDemigod>true</forDemigod>
    <ability>IAG_DG_HealingLight_Life</ability>
    <row>2</row>
    <column>0</column>
    <pointCost>3</pointCost>
    <minDemigodLevel>7</minDemigodLevel>
