  <ImAGod.DivineNodeDef>
    <defName>IAG_DGNode_Destruction_Blast</defName>
    <label>blast</label>
    <domain>IAG_Domain_Destruction</domain>
    <power>IAG_DGP_Blast_Destruction</power>
    <forDemigod>true</forDemigod>
    <ability>IAG_DG_Blast_Destruction</ability>
    <row>1</row>
    <column>0</column>
