<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>IAG_DivineShrine</defName>
    <label>divine shrine</label>
    <description>A statue of the colony's god on a stepped pedestal, where believers of the colony's ideoligion can pray to their god in their free time. Prayer is a meditative recreation that offers faith to the god, more from those whose belief is certain.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>ImAGod/Buildings/DivineShrine</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.8,1.8)</drawSize>
      <shadowData>
        <volume>(0.6,0.5,0.5)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <uiIconScale>0.9</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <designationCategory>Joy</designationCategory>
    <stuffCategories>
      <li>Stony</li>
      <li>Woody</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>6</Beauty>
      <JoyGainFactor>1</JoyGainFactor>
    </statBases>
    <building>
      <joyKind>Meditative</joyKind>
    </building>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

</Defs>
