<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Carried by the prophet who channels great miracles. At severity 1 the prophet cannot channel any more. -->
  <HediffDef>
    <defName>IAG_DivineChanneling</defName>
    <label>divine channeling</label>
    <description>This person has recently channeled the power of a god. Mortal flesh is not made to carry such power, and it needs time to recover.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.8, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.5</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.35</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>strained</label>
        <painOffset>0.1</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>overwhelmed</label>
        <painOffset>0.2</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>IAG_Incarnation</defName>
    <label>divine incarnation</label>
    <description>The god itself dwells within this person. They move faster, strike harder, see further, feel no pain and shrug off harm.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.85, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="ImAGod.HediffCompProperties_AfterEffect">
        <hediff>IAG_DivineExhaustion</hediff>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0</painFactor>
        <totalBleedFactor>0.25</totalBleedFactor>
        <naturalHealingFactor>4</naturalHealingFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.4</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.3</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>0.3</offset>
          </li>
        </capMods>
        <statOffsets>
          <MeleeHitChance>8</MeleeHitChance>
          <MeleeDodgeChance>10</MeleeDodgeChance>
          <ShootingAccuracyPawn>8</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.5</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>IAG_DivineExhaustion</defName>
    <label>divine exhaustion</label>
    <description>A god has recently departed this body, leaving it drained.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <restFallFactor>1.5</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- A raider blessed by a rival god. Slaying them humbles that god. -->
  <HediffDef>
    <defName>IAG_Champion</defName>
    <label>divine champion</label>
    <description>This person has been blessed by a rival god to lead its faithful into battle. They are stronger, faster and harder to kill. Slaying them will humble their god.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.4, 0.35)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="ImAGod.HediffCompProperties_Champion" />
    </comps>
    <stages>
      <li>
        <painFactor>0.5</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.15</offset>
          </li>
        </capMods>
        <statOffsets>
          <MeleeHitChance>5</MeleeHitChance>
          <ShootingAccuracyPawn>5</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.7</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
