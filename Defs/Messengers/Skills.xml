  </ImAGod.MessengerSkillDef>

  <ImAGod.MessengerSkillDef>
    <defName>IAG_Skill_ParalysingGaze</defName>
    <label>paralysing gaze</label>
    <description>The beholder fixes one enemy with its stare, freezing them where they stand.</description>
