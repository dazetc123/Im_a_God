<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Skills of the divine messengers. The AI casts a ready skill when it is worth it (aiMinTargets enemies caught),
    trying skills with higher aiPriority first; the player can also order any skill from the messenger's gizmos.
    cooldownTicks / warmupTicks: 60 ticks = 1 second.
    armorPenetration is vanilla (1 = 100%); armorPenetrationCE is used with Combat Extended (mm for sharp, MPa for blunt).
  -->

  <!-- ================================================================ Seraphim -->

  <ImAGod.MessengerSkillDef>
    <defName>IAG_Skill_HolyArc</defName>
    <label>holy arc</label>
    <description>A sweeping arc of white fire from the Seraphim's six wings, burning through every enemy in a long line.</description>
    <workerClass>ImAGod.MessengerSkill_Beam</workerClass>
    <iconPath>ImAGod/Skills/HolyArc</iconPath>
    <range>30</range>
    <width>1.1</width>
    <cooldownTicks>420</cooldownTicks>
    <warmupTicks>40</warmupTicks>
    <damageDef>Flame</damageDef>
    <damage>42</damage>
    <armorPenetration>1.2</armorPenetration>
    <armorPenetrationCE>38</armorPenetrationCE>
    <fireChance>0.35</fireChance>
    <color>(255, 235, 170)</color>
    <sound>Pawn_Nociosphere_Arc</sound>
    <aiPriority>2</aiPriority>
  </ImAGod.MessengerSkillDef>

  <ImAGod.MessengerSkillDef>
    <defName>IAG_Skill_Judgement</defName>
    <label>pillar of judgement</label>
    <description>Marks a place with a ring of light; a moment later a pillar of holy fire falls on it, blasting everything around.</description>
    <workerClass>ImAGod.MessengerSkill_Pillar</workerClass>
    <iconPath>ImAGod/Skills/Judgement</iconPath>
    <target>Cell</target>
    <range>45</range>
    <needsLineOfSight>false</needsLineOfSight>
    <radius>3.9</radius>
    <delayTicks>90</delayTicks>
    <cooldownTicks>900</cooldownTicks>
    <warmupTicks>30</warmupTicks>
    <damageDef>Bomb</damageDef>
    <damage>60</damage>
    <armorPenetration>1.1</armorPenetration>
    <armorPenetrationCE>170</armorPenetrationCE>
    <fireChance>0.2</fireChance>
    <color>(255, 225, 140)</color>
    <aiMinTargets>2</aiMinTargets>
    <aiPriority>3</aiPriority>
  </ImAGod.MessengerSkillDef>

  <ImAGod.MessengerSkillDef>
    <defName>IAG_Skill_DivineSkip</defName>
    <label>divine skip</label>
    <description>The Seraphim folds space and appears beside its target in a flash of light, dazzling the enemies around where it lands.</description>
    <workerClass>ImAGod.MessengerSkill_Blink</workerClass>
    <iconPath>ImAGod/Skills/DivineSkip</iconPath>
    <range>50</range>
    <needsLineOfSight>false</needsLineOfSight>
    <radius>2.5</radius>
    <cooldownTicks>720</cooldownTicks>
    <warmupTicks>15</warmupTicks>
    <stunTicks>90</stunTicks>
    <color>(255, 245, 210)</color>
    <sound>Psycast_Skip_Exit</sound>
    <aiPriority>1</aiPriority>
  </ImAGod.MessengerSkillDef>

  <ImAGod.MessengerSkillDef>
    <defName>IAG_Skill_Banishment</defName>
    <label>banishment</label>
    <description>Up to five enemies close to the Seraphim are hurled far across the land and left dazed.</description>
    <workerClass>ImAGod.MessengerSkill_Banish</workerClass>
    <iconPath>ImAGod/Skills/Banishment</iconPath>
    <target>Self</target>
    <radius>5.9</radius>
    <count>5</count>
    <cooldownTicks>1500</cooldownTicks>
    <warmupTicks>20</warmupTicks>
    <damageDef>Blunt</damageDef>
    <damage>10</damage>
    <armorPenetration>0.5</armorPenetration>
    <armorPenetrationCE>160</armorPenetrationCE>
    <stunTicks>180</stunTicks>
    <color>(200, 220, 255)</color>
    <sound>Psycast_Skip_Pulse</sound>
    <aiMinTargets>3</aiMinTargets>
    <aiPriority>4</aiPriority>
  </ImAGod.MessengerSkillDef>

  <ImAGod.MessengerSkillDef>
    <defName>IAG_Skill_SeraphicHymn</defName>
    <label>seraphic hymn</label>
    <description>The Seraphim sings "holy, holy, holy". Every ally nearby is healed and wrapped in a ward that halves the harm they take for a while.</description>
    <workerClass>ImAGod.MessengerSkill_Aura</workerClass>
    <iconPath>ImAGod/Skills/SeraphicHymn</iconPath>
    <target>Self</target>
    <radius>12</radius>
    <heal>40</heal>
    <hediff>IAG_SeraphWard</hediff>
    <cooldownTicks>2400</cooldownTicks>
    <warmupTicks>45</warmupTicks>
    <color>(255, 240, 190)</color>
    <aiMinTargets>4</aiMinTargets>
    <aiPriority>5</aiPriority>
  </ImAGod.MessengerSkillDef>

  <ImAGod.MessengerSkillDef>
    <defName>IAG_Skill_CallBeholders</defName>
    <label>call the beholders</label>
    <description>Three winged beholders descend to fight beside the Seraphim for half a day (at most six at a time).</description>
    <workerClass>ImAGod.MessengerSkill_Summon</workerClass>
    <iconPath>ImAGod/Skills/CallBeholders</iconPath>
    <target>Self</target>
    <pawnKind>IAG_WingedBeholder</pawnKind>
    <count>3</count>
    <maxSummons>6</maxSummons>
    <lifetimeDays>0.5</lifetimeDays>
    <cooldownTicks>5000</cooldownTicks>
    <warmupTicks>60</warmupTicks>
    <color>(255, 230, 160)</color>
    <aiMinTargets>2</aiMinTargets>
    <aiPriority>6</aiPriority>
  </ImAGod.MessengerSkillDef>

  <!-- ================================================================ Winged beholder -->

  <ImAGod.MessengerSkillDef>
    <defName>IAG_Skill_EyeLaser</defName>
