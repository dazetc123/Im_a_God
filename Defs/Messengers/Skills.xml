    <damageDef>Burn</damageDef>
    <damage>16</damage>
    <armorPenetration>0.9</armorPenetration>
    <armorPenetrationCE>32</armorPenetrationCE>
    <fireChance>0.1</fireChance>
    <color>(255, 210, 120)</color>
