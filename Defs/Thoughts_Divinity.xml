<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThoughtDef>
    <defName>IAG_WitnessedMiracle</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>3</stackLimit>
    <stackedEffectMultiplier>0.6</stackedEffectMultiplier>
    <stages>
      <li>
        <label>witnessed a miracle</label>
        <description>I saw our god's power with my own eyes. We are not alone.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>IAG_Prayed</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>prayed</label>
        <description>I prayed to our god, and I feel that I was heard.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>IAG_FaithCrisis</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>ImAGod.ThoughtWorker_FaithCrisis</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>murmurs of doubt</label>
        <description>People are starting to wonder whether our god is truly with us.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>crisis of faith</label>
        <description>Our faith is shaken. Is anyone listening to our prayers?</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
      <li>
        <label>schism</label>
        <description>Our community of faith is tearing itself apart.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
