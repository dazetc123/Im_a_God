              <armorPenetrationSharp>30</armorPenetrationSharp>
              <armorPenetrationBlunt>180</armorPenetrationBlunt><chanceFactor>0.6</chanceFactor>
            </li>
            </tools>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="IAG_Seraphim"]</xpath>
          <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
