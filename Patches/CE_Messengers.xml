<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Combat Extended: the messengers' attacks pierce armour like a god's should. Melee penetration is
    30-40 mm sharp and 160-180 MPa blunt; their own armour, dodge, parry and crit are set in CE units.
    Skill damage uses armorPenetrationCE in Defs/Messengers/Skills.xml.
  -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- IAG_Seraphim -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="IAG_Seraphim"]/tools</xpath>
          <value>
            <tools>
            <li Class="CombatExtended.ToolCE">
              <label>flaming blade</label>
              <capacities><li>Cut</li></capacities>
              <power>34</power>
              <cooldownTime>1.6</cooldownTime>
              <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
              <armorPenetrationSharp>38</armorPenetrationSharp>
              <armorPenetrationBlunt>175</armorPenetrationBlunt><extraMeleeDamages><li><def>Flame</def><amount>12</amount><chance>0.5</chance></li></extraMeleeDamages>
            </li>
            <li Class="CombatExtended.ToolCE">
              <label>holy spear</label>
              <capacities><li>Stab</li></capacities>
              <power>30</power>
              <cooldownTime>1.5</cooldownTime>
              <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
